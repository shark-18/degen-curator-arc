# Required env for forge script script/Deploy.s.sol
# Copy to .env and fill in.

# Deployer (will be revoked post-deploy; rotate the key after)
PRIVATE_KEY=0x

# Network RPC
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Verification
BASESCAN_API_KEY=

# External Contracts (Base mainnet defaults)
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
PENDLE_ROUTER_V4=0x888888888889758F76e7103c6CbF23ABbF58F946

# Pick the deepest USDC vault on Base (verify before deploy)
# Steakhouse USDC: https://app.morpho.org/base/vault/0xbeeF010f9cb27031ad51e3333f9aF9C6B1228183
# Gauntlet USDC Prime: https://app.morpho.org/base/vault/0xeE8F4eC5672F09119b96Ab6fB59C27E1b7e44b61
MORPHO_USDC_VAULT=

# Multisigs (deploy these as Gnosis Safes BEFORE running the script)
ADMIN_MULTISIG=         # 3/5 Safe + TimelockController in deployment topology
CURATOR_MULTISIG=       # 2/3 Safe
GUARDIAN_KEY=           # Hot EOA on a separate device
KEEPER_ADDRESS=         # Gelato / Chainlink Automation / dedicated EOA
FEE_RECIPIENT=          # Typically the curator multisig
